   "source": [
    "#Check if array is sorted plus rotated\t\n",
    "def check(arr):\n",
    "    count = 0\n",
    "    n = len(arr)\n",
    "\n",
    "    for i in range(n):\n",
    "        if arr[i] > arr[(i + 1) % n]:\n",
    "            count += 1\n",
    "\n",
    "    return count <= 1"
   ]
  }
