   "source": [
    "#First and last occurrence in sorted array with duplicates\n",
    "def first_last(arr, x):\n",
    "    first = last = -1\n",
    "\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i] == x:\n",
    "            if first == -1:\n",
    "                first = i\n",
    "            last = i\n",
    "\n",
    "    return first, last"
   ]
  }
