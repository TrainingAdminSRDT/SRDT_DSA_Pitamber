   "source": [
    "class Node:\n",
    "    def __init__(self, data):\n",
    "        self.data = data\n",
    "        self.prev = self.next = None\n",
    "\n",
    "# Create nodes\n",
    "a = Node(10)\n",
    "b = Node(20)\n",
    "\n",
    "# Link them\n",
    "a.next = b\n",
    "b.prev = a\n",
    "\n",
    "print(a.data, \"<->\", b.data)"
   ]
  }
 ],
